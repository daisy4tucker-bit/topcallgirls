GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Your Supabase project URL:
VITE_SUPABASE_URL="https://uslqcqzmwaqgqxznvqqt.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://uslqcqzmwaqgqxznvqqt.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Paste your anon public key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"

